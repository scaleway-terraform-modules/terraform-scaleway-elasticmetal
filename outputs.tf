output "public_ips" {
  description = "Public host addresses"
  value       = try(scaleway_baremetal_server.this.ips[*].address, null)
}

output "public_fqdn" {
  description = "Public Fully qualified domain name generated by Scaleway"
  value       = scaleway_baremetal_server.this.domain
}

output "id" {
  description = "ID of the elasticmetal server"
  value       = scaleway_baremetal_server.this.id
}

output "server" {
  description = "The scaleway_baremetal_server resource"
  value       = scaleway_baremetal_server.this
}

output "dns_fqdn" {
  description = "Fully qualified domain name for the DNS record (if created)"
  value = (
    length(scaleway_domain_record.this) > 0
    ? scaleway_domain_record.this[0].fqdn
    : null
  )
}